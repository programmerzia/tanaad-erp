{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": false, "noUnusedParameters": false, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "isolatedModules": true, "moduleDetection": "force", "noEmit": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "types": ["vite/client", "vite-plugin-pwa/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"], "@tanaad/domain": ["../../packages/domain/src/index.ts"] }
  },
  "include": ["src", "../../packages/domain/src"]
}
